{
  "name": "Spectrum Cartography — ROS 2 Humble + Gazebo Harmonic",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": {
      "USERNAME": "ros",
      "USER_UID": "1000"
    }
  },
  "remoteUser": "ros",
  // Mounts folder at ~/host
  "workspaceFolder": "/home/ros/host",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/host,type=bind",
  "runArgs": [
    "--platform=linux/amd64",
    "--net=host",
    "--ipc=host",
    // Simulate Jetson Orin Nano 8GB: 8 GB RAM (no swap) and 6 CPU cores.
    "--memory=8g", "--memory-swap=8g",
    "--cpuset-cpus=0-5",
    // Delete these lines above to run without the cap.
    "-e", "DISPLAY=host.docker.internal:0",
    "-e", "LIBGL_ALWAYS_SOFTWARE=1",
    "-e", "MESA_GL_VERSION_OVERRIDE=3.3",
    "-e", "MESA_LOADER_DRIVER_OVERRIDE=softpipe",
    "-e", "EGL_PLATFORM=surfaceless"
  ],
  "containerEnv": {
    "ROS_DOMAIN_ID": "42",
    "GZ_VERSION": "harmonic"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "sed 's/\\r$//' ~/host/launch_sim.sh > ~/launch_sim.sh && chmod +x ~/launch_sim.sh && echo 'Dev container ready. Run: bash ~/launch_sim.sh'"
}
